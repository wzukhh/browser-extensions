{
  "manifest_version": 3,
  "name": "Word2PDF Converter",
  "version": "1.0.0",
  "description": "Batch convert Word documents to PDF on Windows via Office/WPS (native host)",
  "author": "wzukhh",

  "action": {
    "default_title": "Word2PDF Converter",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "permissions": [
    "nativeMessaging"
  ],

  "key": ""
}
