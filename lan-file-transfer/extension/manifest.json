{
  "manifest_version": 3,
  "name": "LAN 文件传输",
  "version": "1.0.0",
  "description": "扫码即可在电脑和手机之间互相传输文件，所有数据仅在局域网内传输",
  "author": "",
  "homepage_url": "https://github.com/wzukhh/browser-plugin",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "LAN 文件传输",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "permissions": [
    "nativeMessaging"
  ],

  "key": ""
}
